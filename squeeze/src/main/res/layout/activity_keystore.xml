<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_soft" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_back_home" style="@style/BackButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←  ホーム" />
        <TextView style="@style/ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Squeeze Wallet" />
        <TextView style="@style/ScreenSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="ギフト残高をこの端末で安全に利用できます。" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="ウォレットのロック" android:textColor="@color/navy_900" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rg_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <RadioButton android:id="@+id/rb_no_auth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="すぐに使う" />
            <RadioButton android:id="@+id/rb_auth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="画面ロックで確認" />
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="ギフトコード" app:boxBackgroundMode="outline">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_plaintext" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_encrypt" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="ウォレットに追加" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_decrypt" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="残高を使う" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_decrypt_auth" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="確認して残高を使う" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_keyinfo" style="@style/BackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ウォレット情報" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_recreate" style="@style/BackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ウォレットをリセット" />
        <TextView android:id="@+id/tv_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_result" android:fontFamily="monospace" android:textColor="@color/slate_700" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
