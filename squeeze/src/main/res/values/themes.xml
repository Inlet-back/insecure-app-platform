<resources>
    <style name="Base.Theme.InsecureAppPlatform" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/navy_900</item>
        <item name="android:colorAccent">@color/blue_600</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:statusBarColor">@color/surface_soft</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface_soft</item>
    </style>

    <style name="Theme.InsecureAppPlatform" parent="Base.Theme.InsecureAppPlatform" />

    <style name="ScreenTitle">
        <item name="android:textColor">@color/navy_900</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenSubtitle">
        <item name="android:textColor">@color/slate_500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="BackButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/slate_700</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
