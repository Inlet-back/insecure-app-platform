<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_back_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back to Menu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="第1章で保存した認証情報を、3通りの経路で同じサーバへ送る。\ntools/mockserver/server.py を起動してから押すこと。" />

        <Button
            android:id="@+id/btn_http"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. HTTP で送る" />

        <Button
            android:id="@+id/btn_https"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. HTTPS で送る" />

        <Button
            android:id="@+id/btn_https_pinned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. HTTPS + 公開鍵ピン留めで送る" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
