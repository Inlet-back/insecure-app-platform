<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_back_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back to Menu" />

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_no_auth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="認証なしの鍵 (tee_demo_key)" />

            <RadioButton
                android:id="@+id/rb_auth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="認証つきの鍵 (tee_demo_key_auth)" />
        </RadioGroup>

        <EditText
            android:id="@+id/et_plaintext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="秘密にしたい文字列" />

        <Button
            android:id="@+id/btn_encrypt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keystore の鍵で暗号化" />

        <Button
            android:id="@+id/btn_decrypt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="認証せずに復号する" />

        <Button
            android:id="@+id/btn_decrypt_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="認証してから復号する" />

        <Button
            android:id="@+id/btn_keyinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="鍵がどこにあるか調べる" />

        <Button
            android:id="@+id/btn_recreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="この鍵を削除して作り直す" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
